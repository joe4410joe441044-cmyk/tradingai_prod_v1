# Example only. Do not include this file until the production checklist passes.
# Replace the example server name and authentication file with approved values.

location = /api/ai-advisor/conversation {
    if ($request_method = OPTIONS) { return 403; }

    auth_basic "TradingAI";
    # Operator replacement is required. Never install this example unchanged.
    # Never store the authentication file in this repository.
    auth_basic_user_file /etc/nginx/REPLACE_ME_AI_ADVISOR_AUTH_FILE;

    client_max_body_size 12128;
    proxy_connect_timeout 5s;
    proxy_read_timeout 36s;
    proxy_send_timeout 36s;

    proxy_pass http://127.0.0.1:8001;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

    # Never forward a browser credential or browser-selected identity.
    proxy_set_header Authorization "";
    proxy_set_header X-TradingAI-Authenticated-User $remote_user;
    proxy_set_header X-TradingAI-Client "web";
}

